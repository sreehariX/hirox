# Required for live research. Keep real values in .env.local, never in Git.
CRUSTDATA_API_KEY=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase persistence. Use the project URL and a server-only secret key.
# Accepts a Supabase secret key or legacy service_role key. Server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Session pooler URL for one-time table setup. The app does not use it at runtime.
SUPABASE_DB_URL=

# Required when deploying publicly; optional on localhost.
HIROX_ACCESS_PASSWORD=

# local = persisted files on this machine; supabase = hosted Postgres
HIROX_STORAGE=local
